root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml}]
indent_size = 2

[*.md]
# у Markdown два пробіли в кінці рядка означають перенесення
trim_trailing_whitespace = false

[*.cs]
max_line_length = 100

# форматування у стилі Allman
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:warning
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
dotnet_sort_system_directives_first = true

# сучасний синтаксис C#
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# іменування: константи в PascalCase (N7) — правило специфічніше за priv_underscore,
# тому приватна константа VatRate не вимагає префікса _
dotnet_naming_rule.const_pascal.symbols = const_field
dotnet_naming_rule.const_pascal.style = pascal
dotnet_naming_rule.const_pascal.severity = warning
dotnet_naming_symbols.const_field.applicable_kinds = field
dotnet_naming_symbols.const_field.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# іменування: статичні поля лише для читання (таблиці правил) — PascalCase, як і
# константи (N7); узгоджено з правилом StyleCop SA1311
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_field
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly_field.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field.required_modifiers = static, readonly

# іменування: приватні поля з підкресленням
dotnet_naming_rule.priv_underscore.symbols = priv_field
dotnet_naming_rule.priv_underscore.style = underscore_camel
dotnet_naming_rule.priv_underscore.severity = warning
dotnet_naming_symbols.priv_field.applicable_kinds = field
dotnet_naming_symbols.priv_field.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# іменування: інтерфейси з префіксом I
dotnet_naming_rule.interface_prefix.symbols = interfaces
dotnet_naming_rule.interface_prefix.style = prefix_i
dotnet_naming_rule.interface_prefix.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I

# StyleCop: свідомо вимкнені правила
# заголовок з ліцензією в навчальному проєкті не потрібен
dotnet_diagnostic.SA1633.severity = none
# префікс this. суперечить конвенції .NET; поля й так відрізняються префіксом _
dotnet_diagnostic.SA1101.severity = none
# using поза namespace — стандарт шаблонів .NET
dotnet_diagnostic.SA1200.severity = none
# приватні поля іменуємо з _, як прийнято в .NET (див. правило priv_underscore вище)
dotnet_diagnostic.SA1309.severity = none
# документація українською (C3), а SA1623/SA1642 вимагають англійських шаблонів
# «Gets…» та «Initializes a new instance…»; зміст опису перевіряє рецензент
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1642.severity = none
# кома в кінці багаторядкового ініціалізатора необов'язкова
dotnet_diagnostic.SA1413.severity = none

# правила, які лишаємо суворими
# XML-документація обов'язкова для публічних членів (з ЛР № 2, C2)
dotnet_diagnostic.SA1600.severity = warning
# зайві пробіли в кінці рядка
dotnet_diagnostic.SA1028.severity = warning
# порядок членів класу: поля, конструктори, властивості, методи
dotnet_diagnostic.SA1201.severity = warning
# фігурні дужки обов'язкові навіть для однієї інструкції
dotnet_diagnostic.SA1503.severity = warning
# між членами класу — порожній рядок
dotnet_diagnostic.SA1516.severity = warning
# загальне форматування коду (те саме, що перевіряє dotnet format)
dotnet_diagnostic.IDE0055.severity = warning

[tests/**.cs]
# імена тестів за схемою Метод_Умова_Результат (N13) містять підкреслення
dotnet_diagnostic.CA1707.severity = none
# тести не є публічним API: поведінку описує ім'я тесту, XML-документація зайва
dotnet_diagnostic.SA1600.severity = none

[src/ClinicReception.Core/Legacy/**.cs]
# клас-Бог з ЛР 4 (завдання 5) вносимо майже без змін, щоб провести аудит SOLID
# на справжньому коді; секцію видаляємо разом із текою Legacy у завданні 6
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1503.severity = none
dotnet_diagnostic.SA1516.severity = none
dotnet_diagnostic.SA1122.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.IDE0011.severity = none
